    - target: {fileID: 4573000082925304855, guid: c03512d7b595541c88cdbbcae67b13b2, type: 3}
      propertyPath: m_text
      value: "\n\nCiao! \U0001F44BSiamo ragazzi della Valbregaglia \U0001F3D4\uFE0F\U0001F5FB\uFE0F.
        Ci piace \U0001F49A molto la nostra valle \U0001F49A e vogliamo farvela conoscere.
        Abbiamo mostrato alcuni dei nostri posti preferiti \U0001F49A\U0001F5FA\uFE0F
        anche a Francesca \U0001F917\U0001F46B. Lei ha creato una password segreta
        \U0001F92B\U0001F511 durante il suo soggiorno in Valbregaglia \U0001F4C6.
        Vogliamo aiutarvi a scoprire la password \U0001F50D. Siete pronti? Si comincia.
        \U0001F389\U0001F44F"
      objectReference: {fileID: 0}
    - target: {fileID: 4573000082925304855, guid: c03512d7b595541c88cdbbcae67b13b2, type: 3}
      propertyPath: m_overflowMode
